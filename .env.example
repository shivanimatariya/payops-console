# --- from backend/.env.example ---
# Secret used to sign auth tokens. Set a long random value in production.
APEX_SECRET=change-me
# Comma-separated allowed origins for CORS (default '*').
APEX_CORS=*

# --- Transactional emails (Wave 1 #2). Choose SMTP or Resend. ---
FROM_EMAIL=noreply@example.com
# SMTP (e.g., Gmail, SendGrid):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# Or Resend API:
# RESEND_API_KEY=re_...

# --- from frontend/.env.example ---
# Point the app at its backend. Leave empty to use the in-memory mock.
VITE_API_URL=http://localhost:8000
